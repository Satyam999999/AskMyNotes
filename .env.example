# Groq API Key - Get from https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Qdrant Cloud - Create free cluster at https://cloud.qdrant.io
QDRANT_URL=https://your-cluster-url.us-east-2-0.aws.cloud.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_api_key_here

# LangSmith Tracing (optional) - Sign up at https://smith.langchain.com
LANGCHAIN_API_KEY=lsv2_your_key_here
LANGCHAIN_TRACING_V2=true
LANGSMITH_PROJECT=AskMyNotes
